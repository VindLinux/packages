{
    "name": "dracut",
    "description": "Event-driven initramfs infrastructure used to generate the initial RAM filesystem, responsible for locating and mounting the real root filesystem at boot.",
    "version": "112",
    "dependencies": [
        "kmod",
        "cpio",
        "util-linux"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o dracut-112.tar.gz https://github.com/dracut-ng/dracut/archive/refs/tags/112.tar.gz",
        "tar -xf dracut-112.tar.gz"
    ],
    "build": [
        "cd dracut-112 && ./configure --prefix=\"$PREFIX\" --sysconfdir=/etc --disable-documentation",
        "cd dracut-112 && make $MAKEOPTS"
    ],
    "install": [
        "cd dracut-112 && make DESTDIR=\"$DESTDIR\" install"
    ]
}

{
  "name": "cbindgen",
  "description": "A tool for generating C bindings for Rust code.",
  "version": "0.29.2",
  "dependencies": [
    "rustc"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o cbindgen-0.29.2.tar.gz https://github.com/mozilla/cbindgen/archive/v0.29.2/cbindgen-0.29.2.tar.gz",
    "tar -xf cbindgen-0.29.2.tar.gz"
  ],
  "build": [
    "cd cbindgen-0.29.2 && cargo build --release --locked"
  ],
  "install": [
    "cd cbindgen-0.29.2 && install -Dm755 target/release/cbindgen \"$DESTDIR$PREFIX/bin/cbindgen\""
  ],
  "strip": [
    "find \"$DESTDIR$PREFIX\" -type f -exec sh -c 'file \"$1\" | grep -q \"ELF\" && strip --strip-unneeded \"$1\"' _ {} \\; 2>/dev/null || true"
  ]
}

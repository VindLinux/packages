{
  "name": "wayland-protocols",
  "description": "XML protocol definitions for standardized Wayland extensions beyond the core protocol (xdg-shell, xdg-decoration, presentation-time, tablet, etc), consumed by compositors and toolkits via wayland-scanner.",
  "version": "1.49",
  "dependencies": ["wayland", "meson", "ninja"],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o wayland-protocols-1.49.tar.xz https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/1.49/downloads/wayland-protocols-1.49.tar.xz",
    "tar -xf wayland-protocols-1.49.tar.xz"
  ],
  "build": [
    "meson setup wayland-protocols-1.49/build wayland-protocols-1.49 --prefix=\"$PREFIX\" --buildtype=release -Dtests=false",
    "ninja -C wayland-protocols-1.49/build $MAKEOPTS"
  ],
  "install": ["DESTDIR=\"$DESTDIR\" ninja -C wayland-protocols-1.49/build install"],
  "strip": []
}


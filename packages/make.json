{
	"name": "make",
	"description": "GNU Make utility for automatically determining which parts of a program need to be compiled or rebuilt and executing the required commands.",
	"version": "4.4.1",
	"dependencies": [],
	"download": [
		"curl -fL --retry 3 --retry-delay 2 -o make-4.4.1.tar.gz https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz",
		"tar -xf make-4.4.1.tar.gz"
	],
	"build": [
		"cd make-4.4.1 && CFLAGS=\"-std=gnu17 $CFLAGS\" ./configure --prefix=\"$PREFIX\"",
		"cd make-4.4.1 && make $MAKEOPTS"
	],
	"install": [
		"cd make-4.4.1 && make DESTDIR=\"$DESTDIR\" install"
	]
}

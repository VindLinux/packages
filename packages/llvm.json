{
  "name": "llvm",
  "description": "LLVM compiler and toolchain with Clang, LLD, and compiler-rt for musl-based Vind Linux systems.",
  "version": "21.1.8",
  "dependencies": [
    "cmake",
    "ninja",
    "libffi"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o llvm-21.1.8.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/llvm-21.1.8.src.tar.xz",
    "curl -fL --retry 3 --retry-delay 2 -o clang-21.1.8.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/clang-21.1.8.src.tar.xz",
    "curl -fL --retry 3 --retry-delay 2 -o lld-21.1.8.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/lld-21.1.8.src.tar.xz",
    "curl -fL --retry 3 --retry-delay 2 -o compiler-rt-21.1.8.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/compiler-rt-21.1.8.src.tar.xz",
    "curl -fL --retry 3 --retry-delay 2 -o runtimes-21.1.8.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/runtimes-21.1.8.src.tar.xz",
    "curl -fL --retry 3 --retry-delay 2 -o libunwind-21.1.8.src.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/libunwind-21.1.8.src.tar.xz",
    "curl -fL --retry 3 --retry-delay 2 -o llvm-cmake-21.1.8.src.tar.xz https://anduin.linuxfromscratch.org/BLFS/llvm/llvm-cmake-21.1.8.src.tar.xz",
    "curl -fL --retry 3 --retry-delay 2 -o llvm-third-party-21.1.8.src.tar.xz https://anduin.linuxfromscratch.org/BLFS/llvm/llvm-third-party-21.1.8.src.tar.xz",
    "mkdir -p llvm-project",
    "tar -xf llvm-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/llvm-21.1.8.src llvm-project/llvm",
    "tar -xf clang-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/clang-21.1.8.src llvm-project/clang",
    "tar -xf lld-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/lld-21.1.8.src llvm-project/lld",
    "tar -xf compiler-rt-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/compiler-rt-21.1.8.src llvm-project/compiler-rt",
    "tar -xf libunwind-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/libunwind-21.1.8.src llvm-project/libunwind",
    "rm -rf llvm-project/runtimes",
    "tar -xf runtimes-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/runtimes-21.1.8.src llvm-project/runtimes",
    "tar -xf llvm-cmake-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/cmake-21.1.8.src llvm-project/cmake",
    "tar -xf llvm-third-party-21.1.8.src.tar.xz -C llvm-project",
    "mv llvm-project/third-party-21.1.8.src llvm-project/third-party"
  ],
  "build": [
    "mkdir -p llvm-project/llvm/build",
    "cd llvm-project/llvm/build && cmake -G Ninja -S .. -B . -D CMAKE_INSTALL_PREFIX=\"$PREFIX\" -D CMAKE_SKIP_INSTALL_RPATH=ON -D LLVM_ENABLE_FFI=ON -D CMAKE_BUILD_TYPE=Release -D LLVM_BUILD_LLVM_DYLIB=ON -D LLVM_LINK_LLVM_DYLIB=ON -D LLVM_ENABLE_RTTI=ON -D LLVM_STATIC_LINK_CXX_STDLIB=ON -D CMAKE_EXE_LINKER_FLAGS=\"-static-libgcc\" -D CMAKE_SHARED_LINKER_FLAGS=\"-static-libgcc\" -D LLVM_ENABLE_PROJECTS=\"clang;lld\" -D LLVM_ENABLE_RUNTIMES=\"compiler-rt\" -D LLVM_TARGETS_TO_BUILD=\"host\" -D LLVM_DEFAULT_TARGET_TRIPLE=\"x86_64-unknown-linux-musl\" -D LLVM_BINUTILS_INCDIR=\"$PREFIX/include\" -D LLVM_INCLUDE_BENCHMARKS=OFF -D LLVM_INSTALL_TOOLCHAIN_ONLY=ON -D LLVM_INCLUDE_TESTS=OFF -D LLVM_INCLUDE_EXAMPLES=OFF -D LLVM_INCLUDE_DOCS=OFF -D LLVM_BUILD_TOOLS=ON -D CLANG_DEFAULT_PIE_ON_LINUX=ON -D CLANG_DEFAULT_TARGET_TRIPLE=\"x86_64-unknown-linux-musl\" -D CLANG_DEFAULT_LINKER=\"lld\" -D CLANG_DEFAULT_RTLIB=\"compiler-rt\" -D CLANG_DEFAULT_UNWINDLIB=\"libunwind\" -D CLANG_CONFIG_FILE_SYSTEM_DIR=/etc/clang -D LLVM_TOOL_GOLD_BUILD=OFF -D COMPILER_RT_BUILD_SANITIZERS=OFF -D COMPILER_RT_BUILD_XRAY=OFF -D COMPILER_RT_BUILD_MEMPROF=OFF -D COMPILER_RT_BUILD_LIBFUZZER=OFF -D COMPILER_RT_BUILD_PROFILE=OFF -D COMPILER_RT_BUILD_ORC=OFF -W no-dev",
    "ninja -C llvm-project/llvm/build $MAKEOPTS"
  ],
  "install": [
    "DESTDIR=\"$DESTDIR\" ninja -C llvm-project/llvm/build install",
    "ln -sf clang \"$DESTDIR$PREFIX/bin/cc\"",
    "ln -sf clang++ \"$DESTDIR$PREFIX/bin/c++\"",
    "ln -sf clang \"$DESTDIR$PREFIX/bin/gcc\"",
    "ln -sf clang++ \"$DESTDIR$PREFIX/bin/g++\"",
    "ln -sf llvm-ar \"$DESTDIR$PREFIX/bin/ar\"",
    "ln -sf llvm-nm \"$DESTDIR$PREFIX/bin/nm\"",
    "ln -sf llvm-ranlib \"$DESTDIR$PREFIX/bin/ranlib\"",
    "ln -sf llvm-objcopy \"$DESTDIR$PREFIX/bin/objcopy\"",
    "ln -sf llvm-objdump \"$DESTDIR$PREFIX/bin/objdump\"",
    "ln -sf llvm-readelf \"$DESTDIR$PREFIX/bin/readelf\"",
    "ln -sf llvm-strip \"$DESTDIR$PREFIX/bin/strip\"",
    "ln -sf llvm-addr2line \"$DESTDIR$PREFIX/bin/addr2line\"",
    "ln -sf llvm-size \"$DESTDIR$PREFIX/bin/size\"",
    "ln -sf llvm-strings \"$DESTDIR$PREFIX/bin/strings\"",
    "ln -sf ld.lld \"$DESTDIR$PREFIX/bin/ld\""
  ],
  "strip": [
    "find \"$DESTDIR$PREFIX\" -type f -exec sh -c 'file \"$1\" | grep -q \"ELF\" && strip --strip-unneeded \"$1\"' _ {} \\; 2>/dev/null || true"
  ]
}
